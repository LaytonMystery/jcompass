{
  "rewrites": [
    { "source": "/", "destination": "/index.js" },
    { "source": "/login", "destination": "/login-shell.js" }
  ],
  "headers": [
    {
      "source": "/index.js",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/login-shell.js",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}